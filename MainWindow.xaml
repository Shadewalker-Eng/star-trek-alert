<Window
    x:Class="StarTrekAlert.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Star Trek Alert">
    <Grid Background="Black" RequestedTheme="Dark" Padding="14,10,14,14" RowSpacing="8">
        <Grid.Resources>
            <Style x:Key="AlertButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontFamily" Value="Bahnschrift" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F5F5F5" />
                <Setter Property="Background" Value="#090909" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderRail" Background="#FFAE6B" CornerRadius="18,0,0,18" Height="16" />
            <Border x:Name="HeaderSegment" Grid.Column="1" Background="#C6ABF2" Height="16" />
            <TextBlock Grid.Column="2" x:Name="StatusText" Foreground="#FFAE6B"
                       FontFamily="Bahnschrift" FontWeight="SemiBold" CharacterSpacing="90"
                       FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <Border x:Name="UpperRail" CornerRadius="18,0,0,0" />
                <Border x:Name="MiddleRail" Grid.Row="1" />
                <Border x:Name="LowerRail" Grid.Row="2" CornerRadius="0,0,0,18" />
            </Grid>
            <Border x:Name="DisplayFrame" Grid.Column="1" Background="Black" BorderThickness="1" CornerRadius="8">
                <Image x:Name="AlertImage" Stretch="Uniform" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="GreenButton" Style="{StaticResource AlertButtonStyle}" Content="CONDITION GREEN"
                    BorderBrush="#7CFF36" AutomationProperties.Name="Condition Green" Click="AlertClicked" />
            <Button x:Name="YellowButton" Grid.Column="1" Style="{StaticResource AlertButtonStyle}" Content="YELLOW ALERT"
                    BorderBrush="#FFE033" AutomationProperties.Name="Yellow Alert" Click="AlertClicked" />
            <Button x:Name="RedButton" Grid.Column="2" Style="{StaticResource AlertButtonStyle}" Content="RED ALERT!"
                    BorderBrush="#FF5344" AutomationProperties.Name="Red Alert!" Click="AlertClicked" />
        </Grid>
    </Grid>
</Window>

